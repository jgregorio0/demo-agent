# Perfil LOCAL: toda la infraestructura es gratuita y corre en tu máquina.
# Ollama solo es necesario en el momento de la inferencia (no para `python main.py`).

# Modelo LLM servido por Ollama (formato LiteLLM: "ollama_chat/<modelo>").
# Pull previo: docker exec -it family-budget-ollama ollama pull llama3.1:8b
LOCAL_LLM_MODEL=ollama_chat/llama3.1:8b
OLLAMA_API_BASE=http://localhost:11434

# Opcional: embeddings del RAG local vía Ollama. Si se deja vacío se usa el
# embedding ONNX por defecto de ChromaDB (all-MiniLM-L6-v2, 100% local).
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Executor de código: "local" (UnsafeLocalCodeExecutor, sin aislamiento) o
# "docker" (ContainerCodeExecutor, aislado; requiere Docker Desktop corriendo).
CODE_EXECUTOR_MODE=local

# Sesiones persistentes (SQLite local).
SESSION_DB_URL=sqlite+aiosqlite:///./family_budget_sessions.db
