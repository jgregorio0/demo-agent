# Perfil PRODUCTION: infraestructura gestionada de GCP (de pago).
# Copia este archivo a `.env.production` y ajusta los valores a tu proyecto.
# `.env.production` está en .gitignore — no commitees credenciales reales.
# Requiere Application Default Credentials: `gcloud auth application-default login`.

GCP_PROJECT_ID=demo-family-finance-gcp
GCP_LOCATION=us-central1
# ID del data store de Vertex AI Search (nombre corto o resource name completo
# projects/<p>/locations/<loc>/collections/default_collection/dataStores/<id>)
VERTEX_SEARCH_DATA_STORE=family-finance-guides-ds
# Opcional: sandbox fijo de Agent Engine. Si se omite, se auto-crea uno por sesión.
# AGENT_ENGINE_SANDBOX=projects/<p>/locations/<loc>/reasoningEngines/<re>/sandboxes/<sbx>
# Obligatorio para Memory Bank: ID del Agent Engine (reasoning engine) desplegado.
AGENT_ENGINE_ID=

GEMINI_ORCHESTRATOR_MODEL=gemini-2.5-flash
GEMINI_ADVISOR_MODEL=gemini-2.5-flash
GEMINI_ANALYST_MODEL=gemini-2.5-pro

# En producción la sesión puede apuntar a PostgreSQL/Cloud SQL:
# SESSION_DB_URL=postgresql+asyncpg://user:pass@host:5432/family_budget
